# --- Jarvis-son V1: Exclusiones de Privacidad y Modelos ---

# Archivos de audio temporales (Privacidad del usuario)
*.wav
*.mp3
*.m4a
tmp/

# Pesos de modelos de Inteligencia Artificial (Prohibido subirlos a Git - Usar manifest.json)
models/*.gguf
models/*.bin
models/*.onnx
!models/manifest.json

# --- Compilación y Entorno (C++, CMake y Termux) ---
build/
*.o
*.obj
*.exe
*.out
*.app
*.so
*.dylib
*.dll

# Directorios de caché de CMake
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake-install.cmake
install_manifest.txt
*.cmake

# Archivos del sistema operativo
.DS_Store
Thumbs.db
